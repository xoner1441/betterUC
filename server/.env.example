PORT=3000
DATA_DIR=/opt/betteruc-relay/data
MAX_CLIENTS=500
PING_TTL_MS=15000

# PostgreSQL persistence. Keep DATABASE_REQUIRED=false for the first migration start.
DATABASE_URL=postgresql://betteruc_app:replace-with-database-password@127.0.0.1:5432/betteruc
DATABASE_REQUIRED=false
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Automated PostgreSQL and JSON recovery backups.
POSTGRES_BACKUP_DIR=/opt/betteruc-relay/data/postgres-backups
BACKUP_RETENTION_DAYS=30
PG_DUMP_BIN=pg_dump
PG_DUMP_TIMEOUT_MS=300000

# Existing platform secrets
TOKEN_PEPPER=replace-with-random-hex
ADMIN_KEY=replace-with-random-admin-key
ALLOW_LEGACY_TOKEN=true

# Optional Discord bot
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
DISCORD_GUILD_ID=replace-with-discord-server-id
DISCORD_TICKET_CATEGORY_NAME=Tickets
DISCORD_TEAM_ROLE_NAMES=Owner,Admin,Helper
DISCORD_MOD_USER_ROLE_NAME=Mod-User
DISCORD_USER_ROLE_NAME=
DISCORD_VIP_ROLE_NAME=VIP
DISCORD_PARTNER_ROLE_NAME=Partner
DISCORD_HELPER_ROLE_NAME=Helper
DISCORD_ADMIN_ROLE_NAME=Admin
DISCORD_ROLE_SYNC_MS=300000
DISCORD_ROLE_SYNC_CREATE_MISSING=true
DISCORD_UPDATE_CHANNEL_NAME=updates
DISCORD_CHANGELOG_CHANNEL_ID=
DISCORD_CHANGELOG_CHANNEL_NAME=changelog
DISCORD_UPDATE_NOTIFY_ROLE_NAME=betterUC Updates
DISCORD_UPDATE_NOTIFY_ROLE_CREATE_MISSING=true
DISCORD_TICKET_LOG_CHANNEL_ID=
DISCORD_TICKET_LOG_CHANNEL_NAME=ticket-logs
DISCORD_TICKET_TRANSCRIPT_DIR=/opt/betteruc-relay/data/ticket-transcripts
DISCORD_SUGGESTION_CHANNEL_ID=
DISCORD_SUGGESTION_CHANNEL_NAME=vorschlaege
DISCORD_BUG_FORUM_CHANNEL_ID=
DISCORD_BUG_FORUM_CHANNEL_NAME=bug-reports
DISCORD_SUGGESTION_GUIDE_ENABLED=true
DISCORD_SUGGESTION_GUIDE_DELAY_MS=1500
DISCORD_MONITOR_ENABLED=true
DISCORD_MONITOR_CHANNEL_ID=
DISCORD_MONITOR_CHANNEL_NAME=systemstatus
DISCORD_MONITOR_CHECK_MS=60000
DISCORD_MONITOR_PIN_MESSAGE=true
DISCORD_BACKUP_MAX_AGE_HOURS=36
DISCORD_CLOUD_ERROR_ALERT_COUNT=5
DISCORD_WEEKLY_CHANNEL_ID=
DISCORD_WEEKLY_CHANNEL_NAME=wochenstatistik
DISCORD_WEEKLY_REPORT_DAY=1
DISCORD_WEEKLY_REPORT_HOUR_UTC=8
DISCORD_ANNOUNCEMENT_CHANNEL_ID=
DISCORD_ANNOUNCEMENT_CHANNEL_NAME=ankündigungen
DISCORD_RELEASE_REPO=xoner1441/betterUC
DISCORD_RELEASE_CHECK_MS=900000
DISCORD_ANNOUNCE_EXISTING_RELEASE=false
DISCORD_CHANGELOG_DATA_URL=https://betteruc.de/data/changelog.json
PUBLIC_CHANGELOG_URL=https://betteruc.de/changelog
PUBLIC_BASE_URL=https://betteruc.de
SCREENSHOT_PUBLIC_BASE_URL=https://betteruc.de
SCREENSHOT_DIR=/opt/betteruc-relay/data/screenshots
SCREENSHOT_MAX_BYTES=12582912
SCREENSHOT_TTL_MS=604800000
SCREENSHOT_CLEANUP_INTERVAL_MS=3600000

# Optional manual clip uploads. Without ALL four R2 values only clip uploads stay disabled.
# Private R2 bucket: no r2.dev/public custom domain. Keys belong on the server only.
CLIP_R2_ACCOUNT_ID=
CLIP_R2_BUCKET=
CLIP_R2_ACCESS_KEY_ID=
CLIP_R2_SECRET_ACCESS_KEY=
CLIP_MAX_BYTES=1073741824
CLIP_DAILY_COUNT=5
CLIP_DAILY_BYTES=3221225472
CLIP_TOTAL_BYTES=107374182400
CLIP_TTL_SECONDS=604800

# Optional TeamSpeak 3 channel description sync using the official UnicaCity faction API.
TEAMSPEAK_FACTION_SYNC_ENABLED=false
TEAMSPEAK_FACTION_SLUG=police
TEAMSPEAK_FACTION_SYNC_MS=600000
TEAMSPEAK_FACTION_API_BASE_URL=https://api.unicacity.eu/api/factions
TEAMSPEAK_FACTION_RENDER_MODE=image
POLICE_FACTION_SLOT_LIMIT=44
TEAMSPEAK_FACTION_SECTION_START=PERSONALAKTE
TEAMSPEAK_FACTION_SECTION_END=STRAFZAHLUNGEN
TEAMSPEAK_FACTION_UNIT_OVERRIDES=FABI1441:SWAT,mteii:SWAT
TEAMSPEAK_QUERY_HOST=replace-with-teamspeak-host
TEAMSPEAK_QUERY_PORT=10011
TEAMSPEAK_QUERY_USERNAME=replace-with-serverquery-user
TEAMSPEAK_QUERY_PASSWORD=replace-with-serverquery-password
TEAMSPEAK_QUERY_TIMEOUT_MS=10000
TEAMSPEAK_VIRTUAL_SERVER_PORT=9987
TEAMSPEAK_VIRTUAL_SERVER_ID=
TEAMSPEAK_CHANNEL_ID=109
TEAMSPEAK_SWAT_CHANNEL_ID=108
TEAMSPEAK_SWAT_SLOT_LIMIT=13
TEAMSPEAK_SWAT_SECTION_START=EINHEITSLISTE
# Leave empty to replace the SWAT list through the end of the description.
TEAMSPEAK_SWAT_SECTION_END=
SWAT_ROSTER_SUPERVISOR_OVERRIDES=mteii

# Public police roster page, TeamSpeak PNG and cached Minecraft heads.
POLICE_ROSTER_API_URL=https://api.unicacity.eu/api/factions/police/members
POLICE_ROSTER_HEAD_BASE_URL=https://mc-heads.net/head
POLICE_ROSTER_CACHE_MS=300000
POLICE_ROSTER_HEAD_CACHE_MS=86400000
POLICE_ROSTER_TIMEOUT_MS=10000
